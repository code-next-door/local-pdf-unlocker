<?xml version="1.0" encoding="utf-8"?>
<!-- No internet and no storage permissions on purpose: files come in and go out only
     through the system pickers, and the app never goes online. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Shows the system's fingerprint/face/PIN prompt before the saved passwords. A "normal"
         permission: granted at install, gives no access to fingerprints or any data. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.PdfUnlocker">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Open with" for a PDF, e.g. an email attachment. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="application/pdf" />
            </intent-filter>
            <!-- The Share menu. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>
        <!-- Reads PDFs in a sandbox (isolated process: no access to the app's files or Keystore). -->
        <service
            android:name=".PdfService"
            android:exported="false"
            android:isolatedProcess="true"
            android:process=":pdf" />
    </application>

</manifest>
