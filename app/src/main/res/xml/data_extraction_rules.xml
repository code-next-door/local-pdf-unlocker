<?xml version="1.0" encoding="utf-8"?>
<!-- The app keeps no data, but nothing should leave the phone through cloud backup or a
     phone-to-phone transfer either (allowBackup="false" no longer covers the transfer). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
